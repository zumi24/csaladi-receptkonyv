[Unit]
Description=Családi Receptkönyv Web Szerver (Flask / Gunicorn)
After=network.target

[Service]
User=pi
WorkingDirectory=/home/pi/recept_adatbazis
ExecStart=/home/pi/recept_adatbazis/venv/bin/gunicorn -w 3 -b 0.0.0.0:5000 app:app
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
