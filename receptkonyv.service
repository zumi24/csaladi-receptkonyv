[Unit]
Description=Csaladi Receptkonyv Web Alkalmazas
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/recept_adatbazis
ExecStart=/bin/bash -lc "cd /home/pi/recept_adatbazis && PORT=5000 npm start"
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
